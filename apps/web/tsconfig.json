{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@amoji/emotion-core": ["../../packages/emotion-core/src/index.ts"],
      "@amoji/robot-face": ["../../packages/robot-face/src/index.ts"],
      "@amoji/vrm-renderer": ["../../packages/vrm-renderer/src/index.ts"],
      "@amoji/engine": ["../../packages/engine/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/emotion-core/src",
    "../../packages/vrm-renderer/src"
  ],
  "exclude": ["node_modules"]
}
