# Copy to apps/web/.env.local (Next loads env from this app directory).
# Nothing here is required. The free voice works with every line left blank.
# Do not commit .env.local. Do not put OpenAI, Google, Azure, or Polly keys in git.

# Edge neural voice relay. Empty = browser opens the free read-aloud socket.
# GitHub Pages cannot host a relay. If a network blocks
# wss://speech.platform.bing.com, deploy server/amoji-proxy (free Cloudflare
# Worker, no key on the Edge route) and set the public URL, no trailing path:
# NEXT_PUBLIC_TTS_PROXY=https://amoji.<you>.workers.dev
NEXT_PUBLIC_TTS_PROXY=

# Optional. The app already uses the public edge-tts read-aloud client token.
# Set this only if that published value changes. Not a secret you create.
NEXT_PUBLIC_EDGE_TTS_TOKEN=

# Optional LLM upgrades (the chat works with none of these). See the root README.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
# MOONSHOT_API_KEY=

# Live world tools are ON by default and need no key.
# Weather: https://api.open-meteo.com/v1/forecast
# "Here": browser geolocation, then https://get.geojs.io/v1/ip/geo.json
# Named place: https://geocoding-api.open-meteo.com/v1/search
# Latest news (GitHub Pages): https://en.wikipedia.org/api/rest_v1/feed/featured/YYYY/MM/DD
#   (zh/ja hosts are tried first). No key. CORS-open.
# Local light news: https://news.google.com/rss/search (Node only; browsers are blocked)
# Restaurants, cafes, parks, things to do: https://photon.komoot.io/api/ (OpenStreetMap).
# Recipes: https://www.themealdb.com/api/json/v1/1/search.php
#   The "1" is TheMealDB's public test key. Do not set a private key for it.
# Hobbies and facts: Wikipedia + https://api.duckduckgo.com/
# Set either of these to 0 to turn the lookup off.
# AMOJI_TOOLS is read by the Node server (/api/chat and server/backend).
# NEXT_PUBLIC_AMOJI_TOOLS is inlined into the browser bundle, which is what
# GitHub Pages (AMOJI_EXPORT=1) actually runs. Set it at build time.
# AMOJI_TOOLS=0
# NEXT_PUBLIC_AMOJI_TOOLS=0

# Optional. Fuller web search via https://api.search.brave.com
# Server-only — used by the Next /api/chat route. Not present on GitHub Pages.
# Not required for weather or news.
# BRAVE_SEARCH_API_KEY=
# NEXT_PUBLIC_BRAVE_SEARCH_API_KEY ships inside the static JavaScript.
# Set it only if you accept the key being public.
# NEXT_PUBLIC_BRAVE_SEARCH_API_KEY=

# Optional. rss2json was the browser bridge for Google News. The public host
# often returns a Cloudflare challenge, so the demo uses Wikipedia instead.
# A key does not currently fix that challenge. Leave unset.
# RSS2JSON_API_KEY=
# NEXT_PUBLIC_RSS2JSON_API_KEY=
