# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.vrma

# licensed public avatar (see ASSET_MANIFEST.md)
!seed-san.vrm

# Internal QA pages: source of truth is apps/web/dev-pages/. `pnpm dev` mirrors
# them back into public/ so they stay reachable at localhost:3000; that mirror
# is a build artifact and must never be committed (it would ship in out/).
/public/catalog.html
/public/decisions.html
/public/gallery.html
/public/voice-debug.html
