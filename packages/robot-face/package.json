{
  "name": "@amoji/robot-face",
  "version": "0.2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "description": "Plug-and-use emotion face for humanoid robots — monitor canvas + LED-matrix (Unitree-style), gaze, lipsync, Http/Unitree drivers.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@amoji/emotion-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
