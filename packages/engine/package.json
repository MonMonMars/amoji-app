{
  "name": "@amoji/engine",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "description": "Amoji Emotion Engine — plug-and-play face + body + voice emotion layer for robots. One API; the licensee's AI stays the brain.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@amoji/emotion-core": "workspace:*",
    "@amoji/robot-face": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
