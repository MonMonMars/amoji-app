# Copy to apps/web/.env.local — Next.js reads env from the app directory,
# not the repo root. Same file: apps/web/.env.example.
# Nothing here is required. The free voice works with every line left blank.
# Do not commit .env.local. Do not put OpenAI, Google, Azure, or Polly keys in git.

# Edge neural voice relay. Empty = browser opens the free read-aloud socket.
# GitHub Pages cannot host a relay. If a network blocks
# wss://speech.platform.bing.com, deploy server/amoji-proxy (free Cloudflare
# Worker, no key on the Edge route) and set the public URL, no trailing path:
# NEXT_PUBLIC_TTS_PROXY=https://amoji.<you>.workers.dev
NEXT_PUBLIC_TTS_PROXY=

# Optional. The app already uses the public edge-tts read-aloud client token.
# Set this only if that published value changes. Not a secret you create.
NEXT_PUBLIC_EDGE_TTS_TOKEN=

# Optional LLM upgrades (the chat works with none of these). See README.md.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
# MOONSHOT_API_KEY=

# Optional Silencio-2 EN emotion/SFX CPU sidecar (DESKTOP smoke / future bake).
# Default off. Never routes zh/Yue. Never code-switches with Edge Cantonese.
# NEXT_PUBLIC_AMOJI_SILENCIO2=0

# Optional production API (leave unset on GitHub Pages).
# When set, Settings can wipe server rows via DELETE /api/storage/me (bearer).
# NEXT_PUBLIC_AMOJI_API=http://127.0.0.1:8787

# Optional Stripe Payment Link for Amoji Plus (web). Webhook secrets stay on the Node API.
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Labeled demo Plus unlock only — never charges real money. Leave unset in production.
# NEXT_PUBLIC_AMOJI_PAYMENT_DEMO=1

# Node API only (@amoji/server):
# Lock CORS to the Pages origin in production (comma-separated). Unset or * = any.
# AMOJI_CORS_ORIGIN=https://monmonmars.github.io
# AMOJI_PUBLIC_ORIGIN=https://monmonmars.github.io/amoji-app
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PAYMENT_LINK=   # optional server mirror of the public Payment Link
# STRIPE_PRICE_ID=       # optional — enables Stripe Checkout Session creation
# AMOJI_BILLING_DEMO=1   # labeled server-side Plus grant; no Stripe charge
# RESEND_API_KEY=
# AMOJI_MAIL_FROM=Amoji <noreply@example.com>
# Optional ops inbox for support form copies (auto-ack still goes to the user).
# AMOJI_SUPPORT_INBOX=ops@example.com
# Optional SQLite path (default data/amoji.sqlite on the Node host).
# AMOJI_DB=
